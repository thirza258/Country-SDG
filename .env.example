# Copy to .env for local development. Docker Compose reads the same file.

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# "False" in any deployed environment.
DJANGO_DEBUG=True

# Comma separated. Add your domain before deploying.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Comma separated, with scheme, e.g. https://sdg.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=

# Set to 1 when running behind a TLS-terminating proxy.
DJANGO_BEHIND_PROXY=

# Optional. Without these the AI summary and news sections do not render;
# nothing else on the site changes.
GEMINI_API_KEY=
NEWS_API_KEY=

# Public UN SDG and SDG.org sources refresh daily on the next visit, without API keys.
SDG_REFRESH_SECONDS=86400
# Optional writable directory for source snapshots; default: var/sdg-cache.
SDG_CACHE_DIR=
